
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 复制项目代码（.env 等敏感文件被 .dockerignore 排除）
COPY . .

# 安装 TradingAgents 项目依赖
RUN python -m pip install --no-cache-dir .

# 安装后端所需依赖
RUN python -m pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    sqlalchemy \
    pymysql \
    cryptography \
    python-dotenv \
    redis \
    rq \
    pandas

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
